      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT g.bezeichnung AS \"Gerätetyp\",\n       sum(f.wartungskosten) + sum(f.vertragskosten_pro_jahr) AS \"Gesamtkosten\",\n       sum(f.anzahl_tickets) AS \"Tickets\",\n       CASE WHEN sum(f.anzahl_tickets) = 0 THEN NULL\n            ELSE round((sum(f.wartungskosten) + sum(f.vertragskosten_pro_jahr)) / sum(f.anzahl_tickets), 2)\n       END AS \"Kosten pro Ticket\"\nFROM business.wartung_kosten_facts f\nJOIN business.dim_geraetetyp g ON g.geraetetyp_sk = f.geraetetyp_sk\nJOIN business.dim_datum d ON d.datum_sk = f.datum_sk\nJOIN business.dim_standort s ON s.standort_sk = f.standort_sk\nWHERE $__timeFilter(d.datum) AND s.standortname IN ($standort)\nGROUP BY 1\nORDER BY \"Kosten pro Ticket\" DESC NULLS LAST",
          "refId": "A"
        }
      ]
