        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Δ zum Gesamtwert",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH gesamt AS (\n    SELECT 100.0 * count(*) FILTER (WHERE f.sla_abweichung_minuten <= 0) / NULLIF(count(*), 0) AS quote\n    FROM business.sla_bearbeitung_facts f\n    JOIN business.dim_datum d ON d.datum_sk = f.datum_sk\n    WHERE $__timeFilter(d.datum)\n),\nje_hersteller AS (\n    SELECT 'Hersteller' AS \"Gruppentyp\", g.hersteller AS \"Gruppe\",\n           count(*) AS \"Anzahl Vorgänge\",\n           100.0 * count(*) FILTER (WHERE f.sla_abweichung_minuten <= 0) / NULLIF(count(*), 0) AS quote\n    FROM business.sla_bearbeitung_facts f\n    JOIN business.dim_geraet g ON g.geraet_sk = f.geraet_sk\n    JOIN business.dim_datum d ON d.datum_sk = f.datum_sk\n    WHERE $__timeFilter(d.datum)\n    GROUP BY 1, 2\n),\nje_standort AS (\n    SELECT 'Standort' AS \"Gruppentyp\", s.standortname AS \"Gruppe\",\n           count(*) AS \"Anzahl Vorgänge\",\n           100.0 * count(*) FILTER (WHERE f.sla_abweichung_minuten <= 0) / NULLIF(count(*), 0) AS quote\n    FROM business.sla_bearbeitung_facts f\n    JOIN business.dim_standort s ON s.standort_sk = f.standort_sk\n    JOIN business.dim_datum d ON d.datum_sk = f.datum_sk\n    WHERE $__timeFilter(d.datum)\n    GROUP BY 1, 2\n)\nSELECT \"Gruppentyp\", \"Gruppe\", \"Anzahl Vorgänge\",\n       round(quote, 1) AS \"Konformitätsrate\",\n       round(quote - (SELECT quote FROM gesamt), 1) AS \"Δ zum Gesamtwert\"\nFROM (\n    SELECT * FROM je_hersteller\n    UNION ALL\n    SELECT * FROM je_standort\n) alle\nORDER BY \"Δ zum Gesamtwert\" ASC",
          "refId": "A"
        }
      ]
    },
