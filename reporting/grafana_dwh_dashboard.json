          "rawQuery": true,
          "rawSql": "SELECT m.team AS \"Team\",\n       round(avg(f.sla_abweichung_minuten), 1) AS \"Ø Abweichung (Min.)\"\nFROM business.sla_bearbeitung_facts f\nJOIN business.dim_mitarbeiter m ON m.mitarbeiter_sk = f.mitarbeiter_sk\nJOIN business.dim_datum d ON d.datum_sk = f.datum_sk\nWHERE $__timeFilter(d.datum)\nGROUP BY 1\nORDER BY 2 DESC",
          "refId": "A"
        }
