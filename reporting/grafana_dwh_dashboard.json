          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT p.bezeichnung AS \"Priorität\",\n       100.0 * count(*) FILTER (WHERE f.sla_abweichung_minuten <= 0) / NULLIF(count(*), 0) AS \"SLA-Quote\"\nFROM business.sla_bearbeitung_facts f\nJOIN business.dim_prioritaet p ON p.prioritaet_sk = f.prioritaet_sk\nJOIN business.dim_datum d ON d.datum_sk = f.datum_sk\nWHERE $__timeFilter(d.datum)\nGROUP BY 1\nORDER BY CASE p.bezeichnung WHEN 'Kritisch' THEN 1 WHEN 'Hoch' THEN 2 ELSE 3 END",
          "refId": "A"
        }
