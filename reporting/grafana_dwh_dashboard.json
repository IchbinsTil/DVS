          "rawSql": "SELECT d.datum::timestamp AS time,\n       g.bezeichnung AS metric,\n       sum(f.wartungskosten) AS \"Wartungskosten\"\nFROM business.wartung_kosten_facts f\nJOIN business.dim_geraetetyp g ON g.geraetetyp_sk = f.geraetetyp_sk\nJOIN business.dim_datum d ON d.datum_sk = f.datum_sk\nJOIN business.dim_standort s ON s.standort_sk = f.standort_sk\nWHERE $__timeFilter(d.datum) AND s.standortname IN ($standort)\nGROUP BY 1, 2\nORDER BY 1",
