          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE f.sla_abweichung_minuten <= 0) / NULLIF(count(*), 0) AS \"SLA-Quote\"\nFROM business.sla_bearbeitung_facts f\nJOIN business.dim_datum d ON d.datum_sk = f.datum_sk\nWHERE $__timeFilter(d.datum)",
