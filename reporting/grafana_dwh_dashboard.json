          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.standortname AS \"Standort\",\n       sum(f.wartungskosten) AS \"Wartungskosten\",\n       sum(f.vertragskosten_pro_jahr) AS \"Vertragskosten\",\n       sum(f.wartungskosten) + sum(f.vertragskosten_pro_jahr) AS \"Gesamtkosten\",\n       sum(f.anzahl_tickets) AS \"Tickets\"\nFROM business.wartung_kosten_facts f\nJOIN business.dim_datum d ON d.datum_sk = f.datum_sk\nJOIN business.dim_standort s ON s.standort_sk = f.standort_sk\nWHERE $__timeFilter(d.datum) AND s.standortname IN ($standort)\nGROUP BY 1\nORDER BY 4 DESC",
