      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH alle AS (\n    SELECT sum(f.wartungskosten) + sum(f.vertragskosten_pro_jahr) AS gesamtkosten_alle,\n           sum(f.anzahl_tickets) AS tickets_alle\n    FROM business.wartung_kosten_facts f\n    JOIN business.dim_datum d ON d.datum_sk = f.datum_sk\n    WHERE $__timeFilter(d.datum)\n),\nje_standort AS (\n    SELECT s.standortname AS \"Standort\",\n           sum(f.wartungskosten) AS \"Wartungskosten\",\n           sum(f.vertragskosten_pro_jahr) AS \"Vertragskosten\",\n           sum(f.wartungskosten) + sum(f.vertragskosten_pro_jahr) AS \"Gesamtkosten\",\n           sum(f.anzahl_tickets) AS \"Tickets\"\n    FROM business.wartung_kosten_facts f\n    JOIN business.dim_standort s ON s.standort_sk = f.standort_sk\n    JOIN business.dim_datum d ON d.datum_sk = f.datum_sk\n    WHERE $__timeFilter(d.datum) AND s.standortname IN ($standort)\n    GROUP BY 1\n)\nSELECT \"Standort\", \"Wartungskosten\", \"Vertragskosten\", \"Gesamtkosten\", \"Tickets\",\n       CASE WHEN \"Tickets\" = 0 THEN NULL\n            ELSE round(\"Gesamtkosten\" / \"Tickets\", 2)\n       END AS \"Kosten pro Ticket\",\n       CASE WHEN \"Tickets\" = 0 THEN NULL\n            ELSE round(\n                (\"Gesamtkosten\" / NULLIF((SELECT gesamtkosten_alle FROM alle), 0))\n                / (\"Tickets\"::numeric / NULLIF((SELECT tickets_alle FROM alle), 0))\n            , 2)\n       END AS \"Kostenindex\"\nFROM je_standort\nORDER BY \"Gesamtkosten\" DESC",
