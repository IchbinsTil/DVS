    {
      "id": 16,
      "type": "table",
      "title": "Δ zum Gesamtwert je Hersteller und Standort",
      "description": "Beantwortet den zweiten Teil von Frage 1: Negative Differenz kennzeichnet einen Schwerpunkt bei SLA-Überschreitungen",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
